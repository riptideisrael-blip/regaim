<?xml version="1.0" encoding="utf-8"?>
<!--
  Moments design system: the only place colors are defined (Sky Clean: light gray-white, white cards with a hairline, one clear blue).
  Code reads them through DS.kt; layouts and drawables through @color/... Never a color literal elsewhere.
-->
<resources>
    <!-- Surfaces -->
    <color name="ds_bg">#F7F9FC</color>              <!-- main background: light cream -->
    <color name="ds_card">#FFFFFF</color>            <!-- cards: warm beige -->
    <color name="ds_card_alt">#EEF3F9</color>        <!-- secondary background: champagne -->
    <color name="ds_line">#E4E9F0</color>            <!-- lines and borders -->
    <!-- Brand -->
    <color name="ds_primary">#1A6FCC</color>         <!-- mocha: brand, active, pressed buttons -->
    <color name="ds_button">#1A6FCC</color>          <!-- primary buttons -->
    <color name="ds_button_pressed">#155BA8</color>
    <color name="ds_button_secondary">#EEF3F9</color>
    <color name="ds_button_secondary_pressed">#E4ECF6</color>
    <color name="ds_on_button">#FFFFFF</color>
    <color name="ds_disabled_bg">#EEF1F5</color>
    <color name="ds_disabled_ink">#A3ADBA</color>
    <!-- Text -->
    <color name="ds_ink">#0F1B2D</color>             <!-- main text: very dark brown -->
    <color name="ds_ink_soft">#5B687A</color>        <!-- secondary text: warm taupe -->
    <color name="ds_on_photo">#FFFFFF</color>        <!-- text and icons over photos / video -->
    <!-- States -->
    <color name="ds_selected_bg">#E8F1FC</color>
    <color name="ds_error">#B3261E</color>
    <color name="ds_error_bg">#FCE8E6</color>
    <color name="ds_success">#1C7F46</color>
    <color name="ds_heart">#C8473F</color>
    <color name="ds_star">#C98A12</color>
    <color name="ds_scrim">#99000000</color>         <!-- dark layer over photos for legible text -->
    <color name="ds_scrim_soft">#40000000</color>
    <color name="ds_shadow">#140F1B2D</color>
    <!-- Over photos and video (neutral, so pictures keep their own colors) -->
    <color name="ds_photo_scrim_strong">#B3000000</color>
    <color name="ds_photo_scrim_mid">#40000000</color>
    <color name="ds_photo_scrim_light">#66000000</color>
    <color name="ds_photo_clear">#00000000</color>
    <color name="ds_photo_control_bg">#59000000</color>
    <color name="ds_photo_control_line">#59FFFFFF</color>
    <color name="ds_photo_track">#4DFFFFFF</color>
    <color name="ds_photo_pill">#80000000</color>
    <color name="ds_check_off">#33000000</color>
    <color name="ds_ripple">#1F1A6FCC</color>        <!-- touch feedback on light surfaces -->
    <color name="ds_ripple_on_dark">#33FFFFFF</color> <!-- touch feedback on mocha / photos -->
    <color name="ds_handle">#33000000</color>        <!-- bottom-sheet handle -->
    <color name="ds_video_bg">#000000</color>        <!-- behind a playing video -->
    <color name="ds_icon_soft_bg">#E8F1FC</color>    <!-- round soft background behind an icon -->

    <!-- Content palette: Pitzki's lesson colors (the color words themselves, readable on cream). -->
    <color name="pitzki_green">#2F7D32</color>
    <color name="pitzki_brown">#7A4E2D</color>
    <color name="pitzki_red">#C62828</color>
    <color name="pitzki_yellow">#B58300</color>
    <color name="pitzki_gray">#616161</color>
    <!-- "White" can't be white on cream: a soft cool gray that still reads as the word for white. -->
    <color name="pitzki_white">#8A9BA8</color>
    <color name="pitzki_black">#1E1E1E</color>
    <color name="pitzki_purple">#7B3FA0</color>
    <color name="pitzki_pink">#D63A7E</color>
    <color name="pitzki_blue">#1E63C4</color>

    <!-- Content palette: initials of people without a photo (warm mocha family, text contrast >= 4.5:1). -->
    <color name="ds_avatar_1_bg">#E8F1FC</color> <color name="ds_avatar_1_ink">#155BA8</color>
    <color name="ds_avatar_2_bg">#E6F6FD</color> <color name="ds_avatar_2_ink">#0B5E80</color>
    <color name="ds_avatar_3_bg">#ECEFFB</color> <color name="ds_avatar_3_ink">#3B4A9C</color>
    <color name="ds_avatar_4_bg">#E7F4F1</color> <color name="ds_avatar_4_ink">#1E6B5C</color>
    <color name="ds_avatar_5_bg">#EEF1F5</color> <color name="ds_avatar_5_ink">#34404F</color>
    <color name="ds_avatar_6_bg">#FDF0E6</color> <color name="ds_avatar_6_ink">#8A4B12</color>

    <!-- Older names used across the app, now pointing at the design system (kept so nothing breaks). -->
    <color name="bg">@color/ds_bg</color>
    <color name="surface">@color/ds_card</color>
    <color name="ink">@color/ds_ink</color>
    <color name="ink_soft">@color/ds_ink_soft</color>
    <color name="accent">@color/ds_button</color>
    <color name="accent_dark">@color/ds_primary</color>
    <color name="danger">@color/ds_error</color>
    <color name="bg_top">@color/ds_bg</color>
    <color name="white">@color/ds_on_photo</color>
    <color name="heart">@color/ds_heart</color>
    <color name="line">@color/ds_line</color>
    <color name="gold">@color/ds_star</color>
    <color name="fill">@color/ds_button_secondary</color>
</resources>
