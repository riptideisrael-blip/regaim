<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- "Is there a new version?" in the settings: opens Android's installer for the APK from our server (not in a Google Play version). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.facebook.katana" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:enableOnBackInvokedCallback="false"
        android:name=".RegaimApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Regaim">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moments" android:host="auth" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ShareActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StoriesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PitzkiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".EpisodeActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />
        <activity
            android:name=".ArrowGameActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".FaceCaptureActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".PitzkiChatActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".StoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CircleActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- "Join in the app" from the family's invite page: moments://join?c=CODE&s=SERVER -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moments" android:host="join" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FamilyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".FamilyChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CommunityActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CaptureNowActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CartoonFilmActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".StudioActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PeriodVideoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DigestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TimelineActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".FamilyFileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SavingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SavingsFundActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FamilyImportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- "Share → Moments · family file" from any app: a picture, a PDF or a message. -->
        <activity
            android:name=".FamilyItemActivity"
            android:exported="true"
            android:label="Moments · תיק המשפחה"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ChildActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CameraImportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BookActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BookViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PrintOrderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />
        <activity
            android:name=".IntroActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PersonFacesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CommunityBookActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".StoryViewerActivity"
            android:exported="false" />
        <activity
            android:name=".DetectionLabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".GooglePhotosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MediaImportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MemoriesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MilestonesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MomentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PeopleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LearnedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TrimActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".SaveTileService"
            android:exported="true"
            android:icon="@drawable/ic_notif"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".ComicActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|location" />

        <service
            android:name=".BookService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".PitzkiService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".WalkRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>
